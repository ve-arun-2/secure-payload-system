APP_NAME=secure-payload-service
APP_ENV=development
LOG_LEVEL=INFO

RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem
# RSA_PRIVATE_KEY_PASSWORD=

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Token bucket: burst capacity and sustained refill rate, per partner_id
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=10
# false = reject with 503 when Redis is down (secure default); true = allow traffic
RATE_LIMIT_FAIL_OPEN=false

MAX_REQUEST_BODY_BYTES=16384
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5
# Publish only a masked Aadhaar number inside the RabbitMQ event
MASK_AADHAAR_IN_EVENTS=false
